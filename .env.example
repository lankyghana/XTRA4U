APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================
# XTRA4U Custom Configuration
# ===========================================

# BulkClix SMS API (https://bulkclix.com)
# Get your API key from the BulkClix dashboard
BULKCLIX_API_KEY=
BULKCLIX_SENDER_ID=XTRA4U
BULKCLIX_BASE_URL=https://bulkclix.com/api/v1

# Paystack Payment Gateway (https://paystack.com)
# Get your keys from the Paystack dashboard
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# GigsHub External Fulfillment API (https://gigzhub.net)
# Required for GigsHub order fulfillment. Get your API key from the GigsHub dashboard.
# NOTE: Vendors can also override these via Vendor Settings > External Fulfillment.
GIGSHUB_BASE_URL=https://gigzhub.net
GIGSHUB_API_KEY=
GIGSHUB_TIMEOUT=30

# Queue stall alerting (queue:health-check). Optional heartbeat URL, e.g. a healthchecks.io check
# that expects a ping every ~5-10 minutes; it alerts you if the scheduler cron dies.
QUEUE_HEALTH_STALE_MINUTES=15
QUEUE_HEALTH_PING_URL=

# Recipient for admin alert emails
ADMIN_EMAIL=

# --- Utility Bills (KiNG FLEXY GH) ---------------------------------------------
# Commission Services key (starts kf_cs_live_). NOT the normal data API key.
# Server-side only. Utility Bills stay unavailable (fail safe) while this is empty.
KINGFLEXY_UTILITIES_API_KEY=
KINGFLEXY_UTILITIES_BASE_URL=https://api.kingflexygh.com/api/v2
KINGFLEXY_UTILITIES_CONNECT_TIMEOUT=5
KINGFLEXY_UTILITIES_TIMEOUT=20
# Tunables (defaults in config/utility_bills.php): cache TTLs, lookup/pay/status rate budgets.
# UTILITY_BILLS_CATALOG_TTL=120
# UTILITY_BILLS_LOOKUP_PER_MINUTE=9
# UTILITY_BILLS_PAY_PER_MINUTE=5
# UTILITY_BILLS_STATUS_PER_MINUTE=25

# --- Developer API sandbox -----------------------------------------------------
# Automatic cleanup of SANDBOX (xt_test_) data is OFF unless this is set. Never touches production data.
# Production setting: 30. Preview with: php artisan developer-sandbox:prune --dry-run
# DEVELOPER_API_SANDBOX_RETENTION_DAYS=30

# --- AI engine foundation (M5.2) -----------------------------------------------
# The engine is OFF by default. Nothing here is required for local development or tests (the offline mock provider
# is used). No assistant UI/route exists yet; these only configure the engine and its safety limits.
# AI_ENABLED=false
# AI_PROVIDER=mock
# AI_DEFAULT_MODEL=
# A LIVE provider (AI_PROVIDER=openai) additionally REQUIRES explicit positive daily REQUEST, TOKEN and COST limits for the
# global scope and for each enabled surface. Leave blank until the spend has been approved - blank/0 never means unlimited.
# No values are suggested here on purpose. Cost limits are in micro-USD (1,000,000 = USD 1).
# AI_GLOBAL_DAILY_REQUESTS=
# AI_GLOBAL_DAILY_TOKENS=
# AI_GLOBAL_DAILY_COST_MICRO_USD=
# AI_CUSTOMER_DAILY_REQUESTS=
# AI_CUSTOMER_DAILY_TOKENS=
# AI_CUSTOMER_DAILY_COST_MICRO_USD=
# AI_VENDOR_DAILY_REQUESTS=
# AI_VENDOR_DAILY_TOKENS=
# AI_VENDOR_DAILY_COST_MICRO_USD=
# AI_DEVELOPER_DAILY_REQUESTS=
# AI_DEVELOPER_DAILY_TOKENS=
# AI_DEVELOPER_DAILY_COST_MICRO_USD=
# Live provider credentials and pricing (never commit real values). Pricing is copied BY A PERSON from the provider's
# official price list for exactly the model named in AI_DEFAULT_MODEL, with the date it was copied:
# AI_OPENAI_API_KEY=
# AI_OPENAI_INPUT_USD_PER_MILLION=
# AI_OPENAI_OUTPUT_USD_PER_MILLION=
# AI_OPENAI_PRICING_AS_OF=
# External-processing approval record. Set ONLY by the person accountable for privacy after the review in
# docs/ai/06 section 5 is signed off. All four are required together; the gate ships closed.
# AI_EXTERNAL_PROCESSING_APPROVED=false
# AI_EXTERNAL_PROCESSING_APPROVAL_REF=
# AI_EXTERNAL_PROCESSING_APPROVED_BY=
# AI_EXTERNAL_PROCESSING_APPROVED_ON=
# Reverse proxies in front of the app (comma-separated IPs/CIDRs; NO wildcards). Leave empty if reached directly.
# TRUSTED_PROXIES=
# Operator attestations that ai:preflight --live cannot verify itself (both default false):
# AI_DIRECT_CONNECTIONS_CONFIRMED=false
# AI_CUSTOMER_WORKER_CAPACITY_CONFIRMED=false
# Provider-side spending cap (M5.7.2). A statement by the account owner that a hard monthly cap is set in the provider's own
# dashboard, with a reference to where that is recorded. ai:preflight cannot check it (no provider API is called) and reports
# live as not ready until both are given. No cap value is suggested here on purpose.
# AI_PROVIDER_SPENDING_CAP_CONFIRMED=false
# AI_PROVIDER_SPENDING_CAP_REFERENCE=
# Independent integrity anchor (M5.7.2), required before ANY live request. It must live OUTSIDE the database's restore domain
# (a different host or volume with its own backup lifecycle) - see docs/ai/06 section 19. Default "none" = live stays blocked.
# The directory must be absolute, writable, and outside the application and its database; the key is at least 32 random characters.
# AI_INTEGRITY_ANCHOR_DRIVER=none
# AI_INTEGRITY_ANCHOR_PATH=
# AI_INTEGRITY_ANCHOR_KEY=
# The operator's attestation that the location above really is independent, and where that is recorded:
# AI_INTEGRITY_ANCHOR_INDEPENDENCE_ATTESTED=false
# AI_INTEGRITY_ANCHOR_INDEPENDENCE_REF=
# Per-surface release switches (all false by default):
# AI_SURFACE_CUSTOMER=false
# AI_SURFACE_VENDOR=false
# AI_SURFACE_DEVELOPER=false
# Instant runtime off switch (no redeploy): php artisan ai:kill-switch engage
